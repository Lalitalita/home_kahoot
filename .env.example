# Copie ce fichier en ".env" puis modifie les valeurs avant de lancer
# `docker compose up -d`.

# Clé secrète utilisée pour signer les jetons de connexion admin (JWT).
# Génère une valeur aléatoire, par exemple avec : openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret

# Identifiants admin créés automatiquement au premier démarrage.
# Change ce mot de passe puis connecte-toi une première fois pour
# activer la double authentification (2FA) obligatoire.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# Durée de validité de la session admin, en minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origines autorisées pour les appels API (CORS). "*" convient si le
# frontend et le backend sont servis derrière le même nom de domaine
# (ce qui est le cas avec le docker-compose fourni, via nginx).
CORS_ORIGINS=*

# Port HTTP exposé sur la machine hôte pour accéder au site.
HTTP_PORT=8080
